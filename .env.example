# `npm run dev` (which runs `vercel dev`) is the default local development
# command — it serves both the frontend and the /api/gemini serverless function,
# so chat actually works locally. `npm run dev:vite` runs the plain Vite dev
# server, which is faster for pure frontend/CSS iteration but cannot serve
# /api/gemini — chat requests will fail against it. Requires the Vercel CLI,
# fetched on demand via npx (not a project dependency); first run may prompt you
# to log in / link the project.

VITE_TMDB_API_KEY=your_tmdb_key_here
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# server-only — read by api/gemini.js (a Vercel serverless function), never by
# browser code. Do NOT prefix with VITE_, or it will be bundled into the client.
# Set this in Vercel's Project Settings -> Environment Variables for deployment;
# for local development it can live in this same .env file, but only api/gemini.js
# (running under `npm run dev` / `vercel dev`, not `npm run dev:vite`) will ever
# read it.
GEMINI_API_KEY=your_gemini_key_here
